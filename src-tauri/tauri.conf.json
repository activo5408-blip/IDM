{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sk-IDM",
  "version": "1.0.0",
  "identifier": "com.skidm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sk-IDM",
        "width": 900,
        "height": 820,
        "minWidth": 700,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/yt-dlp.exe": "yt-dlp.exe"
    }
  }
}
